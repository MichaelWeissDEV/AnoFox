{
  "manifest_version": 3, "name": "anofox-threat-probe", "version": "1.0",
  "permissions": ["declarativeNetRequest", "scripting", "tabs"],
  "host_permissions": ["<all_urls>"],
  "background": { "scripts": ["bg.js"] },
  "web_accessible_resources": [{ "resources": ["blocked.html"], "matches": ["<all_urls>"] }],
  "browser_specific_settings": { "gecko": { "id": "threat-probe@example.org", "strict_min_version": "128.0" } }
}
